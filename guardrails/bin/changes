#!/usr/bin/env bash
# Which parts of a change are code, so CI can skip the jobs a change doesn't
# need. Run from the repository; settings come from dev/guardrails/config.sh.
#
#   changes BASE HEAD   the paths changed between the commits (BASE...HEAD)
#   changes             one path per line on stdin
#   changes --all       everything, for a push or a scheduled run
#
# --expect "name ...", before the rest, names the areas the workflow reads:
# one missing from HEARTWOOD_CI_AREAS fails the script, which runs every job,
# where the workflow would read it as empty and skip its jobs for good.
#
# Prints the lines GITHUB_OUTPUT takes:
#
#   code=true|false                  whether anything but prose changed
#   areas={"name":true|false, ...}   per area in HEARTWOOD_CI_AREAS
#
# Prose touches nothing: the commit gate's (HEARTWOOD_PROSE, matched by
# hooks/prose.sh, a move counted by both its paths) and HEARTWOOD_CI_PROSE,
# files the gate still reviews but no code reads (AGENTS.md, say), matched
# the same way. HEARTWOOD_CI_AREAS ("name=path/ ...") splits the code: a
# path under an area's path touches that area, and a path under none touches
# every area. A path in HEARTWOOD_CI_ALL (matched like the prose) touches
# every area too: the classifier's own files, so a change to it is tested
# whatever it decides. So does dev/guardrails/config.sh, whatever it says.
set -euo pipefail

usage() {
  echo "usage: changes [--expect \"name ...\"] [BASE HEAD | --all]" >&2
  exit 2
}

expect=""
if [[ ${1:-} == --expect ]]; then
  [[ $# -ge 2 ]] || usage
  expect=$2
  shift 2
fi

src=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source-path=SCRIPTDIR source=../hooks/prose.sh
. "$src/hooks/prose.sh"

top=$(git rev-parse --show-toplevel)
config="$top/dev/guardrails/config.sh"
if [[ ! -f "$config" ]]; then
  echo "dev/guardrails/config.sh is missing; it holds this repository's guardrail settings." >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$config"
prose="${HEARTWOOD_PROSE:-docs/ README.md} ${HEARTWOOD_CI_PROSE:-}"
all="${HEARTWOOD_CI_ALL:-}"
read -ra areas <<<"${HEARTWOOD_CI_AREAS:-}"
# An area's path ends in /, so ui=ui/ can't also claim uikit/.
for area in "${areas[@]}"; do
  if [[ "$area" != *=*/ ]]; then
    echo "HEARTWOOD_CI_AREAS: \"$area\" isn't name=path/ (the path ends in /)." >&2
    exit 1
  fi
done
for name in $expect; do
  found=false
  for area in "${areas[@]}"; do [[ ${area%%=*} == "$name" ]] && found=true; done
  if [[ $found == false ]]; then
    echo "HEARTWOOD_CI_AREAS has no area \"$name\", which the workflow reads." >&2
    exit 1
  fi
done

# touched[i] is areas[i]'s answer (indexed arrays: macOS's bash is 3.2).
touched=()
for i in "${!areas[@]}"; do touched[i]=false; done
code=false

touch_all() {
  local i
  code=true
  for i in "${!areas[@]}"; do touched[i]=true; done
}

classify() {
  local path i hit
  while IFS= read -r path || [[ -n "$path" ]]; do
    [[ -z "$path" ]] && continue
    # The settings decide everything else, so a change to them runs
    # everything, whatever they now say.
    if [[ $path == dev/guardrails/config.sh ]] || heartwood_is_prose "$all" "$path"; then
      touch_all
      continue
    fi
    heartwood_is_prose "$prose" "$path" && continue
    code=true
    hit=false
    for i in "${!areas[@]}"; do
      if [[ "$path" == "${areas[i]#*=}"* ]]; then
        touched[i]=true
        hit=true
      fi
    done
    if [[ $hit == false ]]; then touch_all; fi
  done
}

case $# in
  0) classify ;;
  1)
    [[ $1 == --all ]] || usage
    touch_all
    ;;
  2)
    # Listed first, so a failure (an unknown commit) stops the script and CI
    # runs everything; read through a pipe, it would pass for "no change".
    files=$(cd "$top" && heartwood_changed_files "$1...$2")
    classify <<<"$files"
    ;;
  *) usage ;;
esac

json=""
for i in "${!areas[@]}"; do
  json+="${json:+,}\"${areas[i]%%=*}\":${touched[i]}"
done

echo "code=$code"
echo "areas={$json}"
