#!/usr/bin/env bash
# Records the reuse review's verdict for the staged tree.
#
#     record-review pass|block REPORT
#     record-review pass|block - < report
#
# Writes <git dir>/<app>-review/<tree>.md: the verdict, then the report, read
# from the file REPORT or, given "-", from standard input (so a reviewer
# needn't write a file of its own). The commit gate (hooks/pre-commit) lets a
# commit through only when its tree has a file with "verdict: pass".
#
# Refuses when the staging has changed since the packet was made: that
# change hasn't been reviewed.
set -euo pipefail

verdict=${1:-}
report=${2:-}

usage() {
  echo "usage: $0 pass|block REPORT, or $0 pass|block - with the report on standard input" >&2
  exit 1
}

[[ "$verdict" == "pass" || "$verdict" == "block" ]] || usage

if [[ "$report" == "-" ]]; then
  text=$(cat)
elif [[ -f "$report" ]]; then
  text=$(cat "$report")
else
  usage
fi

[[ -n "$text" ]] || usage

top=$(git rev-parse --show-toplevel)
config="$top/dev/guardrails/config.sh"
# shellcheck source=/dev/null
[[ -f "$config" ]] && . "$config"
app=${HEARTWOOD_APP:-heartwood}

git_dir=$(cd "$(git rev-parse --git-dir)" && pwd)
dir="$git_dir/$app-review"
packet="$dir/packet.md"
tree=$(git write-tree)

reviewed=$(sed -n 's/^tree: //p' "$packet" 2>/dev/null | head -1)
if [[ "$reviewed" != "$tree" ]]; then
  echo "The staging changed since the packet was made (packet ${reviewed:-missing}, staged $tree)." >&2
  echo "Make a new packet and review that." >&2
  exit 1
fi

{
  echo "verdict: $verdict"
  echo "tree: $tree"
  echo
  printf '%s\n' "$text"
} >"$dir/$tree.md"

echo "$dir/$tree.md"
